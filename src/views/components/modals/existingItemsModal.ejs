<div id="add_existing_items_modal" class="modal" role="dialog">
  <div class="modal-box w-11/12 max-w-7xl">
    <header>
      <h1 class="text-2xl mb-2">
        All items
      </h1>
      <p>Select all item(s) that you want to add to this category</p>
    </header>
    <article class="overflow-x-auto mt-6">
      <table class="table">
        <thead class="uppercase bg-neutral-200 text-neutral-600">
          <tr>
            <th>Name</th>
            <th>SKU</th>
            <th>Weight</th>
            <th>Roastery</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => { %>
          <tr onclick="window.location='<%= `/items/${item.id}` %>'" aria-label="See more details of item" role="button" class="hover:bg-neutral-100 hover:cursor-pointer">
            <td><%= item.name %></td>
            <td><%= item.sku %></td>
            <td><%= Math.round(item.size_grams) %>g</td>
            <td><%= item.roastery %></td>
          </tr>
          <%}); %>
        </tbody>
      </table>
    </article>
  </div>
</div>