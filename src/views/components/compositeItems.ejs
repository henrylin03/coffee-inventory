<section class="flex-2 flex flex-col gap-4">
  <header class="w-full grid justify-items-end px-8">
    <%- include("./buttonTriggeredDropdown", { text: "Add item", options: [{ label: "Add new item", href: `/items/new?referredCategoryId=${categoryId}` }, { label: "Add existing item", href: `/categories/includeItems?categoryId=${categoryId}` }]}) %>
  </header>
  <div class="overflow-x-auto">
    <table class="table table-auto">
      <thead class="uppercase bg-neutral-200 text-neutral-600">
        <tr>
          <th>Item name</th>
          <th>SKU</th>
          <th>Weight</th>
          <th>Roastery</th>
          <th>Selling price ($AUD)</th>
          <th>Stock on hand</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      </tbody>
    </table>
  </div>
</section>
<script src="
https://cdn.jsdelivr.net/npm/dompurify@3.3.1/dist/purify.min.js
"></script>
<script>
  let items = <%- JSON.stringify(compositeItems) %>;

  const renderItemRows = (items) => {
    if (typeof trustedTypes === "undefined") trustedTypes = {
      createPolicy: (n, rules) => rules
    }
    const policy = trustedTypes.createPolicy("my-policy", {
      createHTML: (input) => DOMPurify.sanitize(input),
    })

    const tableBody = document.querySelector(".table>tbody");
    const innerHtmlString = items.map(item => `<tr data-item-id="${item.id}" aria-label="See more details of item" class="hover:bg-neutral-100 hover:cursor-pointer">
      <td>${policy.createHTML(item.name)}</td>
      <td>${policy.createHTML(item.sku)}</td>
          <td>${Math.round(item.size_grams)}</td>
          <td>${policy.createHTML(item.roastery)}</td>
          <td>${policy.createHTML(item.price_dollars)} <span class="decorative-text">/unit</span></td>
          <td>${item.stock_quantity}</td>
          <td class="grid pr-10">
            <button class="btn btn-circle btn-ghost justify-center" aria-label="Remove item from this category" data-item-id="${item.id}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 lucide lucide-trash-icon lucide-trash stroke-error">
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                <path d="M3 6h18" />
                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
              </svg>
            </button>
          </td>
        </tr>`).join("")
    tableBody.innerHTML = innerHtmlString;
  }

  renderItemRows(items);
  const tableRows = document.querySelectorAll("table tbody tr");
  tableRows.forEach(row => row.addEventListener("click", () => {
    window.location = `/items/${row.dataset.itemId}`;
  }))

  const deleteButtons = document.querySelectorAll("table button");
  deleteButtons.forEach(btn => btn.addEventListener("click", (e) => {
    e.stopPropagation();
    const itemId = btn.dataset.itemId;
    items = items.filter(item => item.id !== itemId);
    renderItemRows(items);
  }))
</script>