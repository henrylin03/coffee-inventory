<section class="flex-2 flex flex-col gap-4">
  <header class="w-full grid justify-items-end px-8">
    <%- include("./buttonTriggeredDropdown", { text: "Add item", options: [{ label: "Add new item", href: `/items/new?referredCategoryId=${categoryId}` }, { label: "Add existing item", href: `/categories/includeItems?categoryId=${categoryId}` }]}) %>
  </header>
  <div class="overflow-x-auto">
    <table class="table table-auto">
      <thead class="uppercase bg-neutral-200 text-neutral-600">
        <tr>
          <th>Item name</th>
          <th>SKU</th>
          <th>Weight</th>
          <th>Roastery</th>
          <th>Selling price ($AUD)</th>
          <th>Stock on hand</th>
        </tr>
      </thead>
      <tbody>
        <% compositeItems.forEach(item => { %>
        <tr onclick="window.location='<%= `/items/${item.id}` %>'" aria-label="See more details of item" class="hover:bg-neutral-100 hover:cursor-pointer">
          <td><%= item.name %></td>
          <td><%= item.sku %></td>
          <td><%= Math.round(item.size_grams) %>g</td>
          <td><%= item.roastery %></td>
          <td><%= item.price_dollars %> <span class="decorative-text">/unit</span></td>
          <td><%= item.stock_quantity %></td>
        </tr>
        <%}); %>
      </tbody>
    </table>
  </div>
</section>