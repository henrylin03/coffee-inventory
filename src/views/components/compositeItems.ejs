<section class="flex-2 flex flex-col gap-4">
  <header class="w-full grid justify-items-end px-8">
    <a href="/categories/includeItems?categoryId=<%= categoryId %>" role="button" class="btn btn-primary"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-todo-icon lucide-list-todo w-4 h-4">
        <path d="M13 5h8" />
        <path d="M13 12h8" />
        <path d="M13 19h8" />
        <path d="m3 17 2 2 4-4" />
        <rect x="3" y="4" width="6" height="6" rx="1" />
      </svg>Modify items</a>
  </header>
  <div class="overflow-x-auto">
    <table class="table table-auto">
      <thead class="uppercase bg-neutral-200 text-neutral-600">
        <tr>
          <th>Item name</th>
          <th>SKU</th>
          <th>Weight</th>
          <th>Roastery</th>
          <th>Selling price ($AUD)</th>
          <th>Stock on hand</th>
        </tr>
      </thead>
      <tbody>
        <% compositeItems.forEach(item => { %>
        <tr onclick="window.location='<%= `/items/${item.id}` %>'" aria-label="See more details of item" class="hover:bg-neutral-100 hover:cursor-pointer">
          <td><%= item.name %></td>
          <td><%= item.sku %></td>
          <td><%= Math.round(item.size_grams) %>g</td>
          <td><%= item.roastery %></td>
          <td><%= item.price_dollars %> <span class="decorative-text">/unit</span></td>
          <td><%= item.stock_quantity %></td>
        </tr>
        <%}); %>
      </tbody>
    </table>
  </div>
</section>