<section class="flex-2 flex flex-col gap-4">
  <header class="w-full grid justify-items-end px-8">
    <%- include("./buttonTriggeredDropdown", { text: "Add item", options: [{ label: "Add new item", href: `/items/new?referredCategoryId=${categoryId}` }, { label: "Add existing item", href: `/categories/includeItems?categoryId=${categoryId}` }]}) %>
  </header>
  <div class="overflow-x-auto">
    <table class="table table-auto">
      <thead class="uppercase bg-neutral-200 text-neutral-600">
        <tr>
          <th>Item name</th>
          <th>SKU</th>
          <th>Weight</th>
          <th>Roastery</th>
          <th>Selling price ($AUD)</th>
          <th>Stock on hand</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      </tbody>
    </table>
  </div>
</section>
<script>
  const tableBody = document.querySelector("table tbody");
  let items = <%- JSON.stringify(compositeItems) %>;

  const renderItemRows = (items) => {
    items.forEach(item => {
      const columnsData = [
        item.name, item.sku, `${Math.round(item.size_grams)}g`, item.roastery, `${item.price_dollars} /unit`, item.stock_quantity
      ]

      const row = document.createElement("tr");
      row.dataset.itemId = item.id;
      row.classList.add("cursor-pointer", "hover:bg-neutral-100");
      row.addEventListener("click", () => window.location = `/items/${row.dataset.itemId}`)

      columnsData.forEach(col => {
        const cell = document.createElement("td");
        cell.textContent = col;
        row.appendChild(cell);
      })
      const deleteButtonCell = document.createElement("td");
      deleteButtonCell.classList.add("grid", "pr-10");
      const deleteButton = document.createElement("button");
      deleteButton.dataset.itemId = item.id;
      deleteButton.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-icon lucide-trash stroke-error w-4 h-4">
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
        <path d="M3 6h18" />
        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
      </svg>`;
      deleteButton.classList.add("btn", "btn-circle", "btn-ghost", "justify-center");
      deleteButton.addEventListener("click", handleDeleteItem);
      deleteButtonCell.appendChild(deleteButton);
      row.appendChild(deleteButtonCell);

      tableBody.appendChild(row);
    })
  }

  const handleDeleteItem = (e) => {
    e.stopPropagation();
    const itemIdForDeletion = e.currentTarget.dataset.itemId;
    items = items.filter(item => Number(item.id) !== Number(itemIdForDeletion));
    tableBody.replaceChildren();
    renderItemRows(items);
  }

  renderItemRows(items);
</script>