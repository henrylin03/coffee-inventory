<%- include("../components/pageHeaders/pageHeaderWithClose.ejs", { 
  heading: "Manage items"
}) %>

<p class="px-8 -mt-6 mb-4">
  Modify the items in the category:
  "<span class="font-bold text-secondary"><%= category.name %></span>"
</p>

<section class="flex-1 overflow-x-auto">
  <table class="table table-fixed">
    <thead class="bg-neutral-200 text-neutral-600 uppercase">
      <tr>
        <th class="w-16">
          <label>
            <input type="checkbox" class="checkbox checkbox-primary checkbox-sm">
          </label>
        </th>
        <th>Name</th>
        <th>SKU</th>
        <th>Weight</th>
        <th>Roastery</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(item => { %>
      <tr onclick="window.location='<%= `/items/${item.id}?referredCategoryId=${category.id}` %>'" aria-label="See more details of item" role="button" class="hover:cursor-pointer hover:bg-neutral-100" data-item-id="<%= item.id %>">
        <th class="w-16">
          <label>
            <input type="checkbox" class="checkbox checkbox-primary checkbox-sm" <%= Number(item["category_id"]) === Number(category.id) 
                  ? "checked" 
                  : "" 
                %>>
          </label>
        </th>
        <td><%= item.name %></td>
        <td><%= item.sku %></td>
        <td><%= Math.round(item.size_grams) %>g</td>
        <td><%= item.roastery %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</section>
<footer class="flex gap-2 border border-base-200 p-6">
  <button class="btn btn-primary">Save</button>
  <button class="btn border-gray-400 bg-white text-gray-500" onclick="history.back()">
    Cancel
  </button>
</footer>
<script src="/js/editItemsInCategoryScript.js"></script>